# AI Services (Required for Logic & Voice)
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
APIFY_API_TOKEN=

# Optional / Alternatives
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Google Vertex AI (for Veo 3 video generation)
# For local development: use file path
GOOGLE_APPLICATION_CREDENTIALS=./vertex-ai-key.json

# For Vercel deployment: paste the ENTIRE JSON content as a single line string
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# Backend API URL (for production deployment)
# NEXT_PUBLIC_API_URL=https://your-backend-url.railway.app/api/v1
